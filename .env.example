# Copy to `.env` (repo root). Both the backend and `docker compose` read it.
# Every key is optional for local development: without API keys ITK runs fully offline,
# using heuristic fallbacks for the AI steps and writing outgoing email to backend/.outbox/.

ENVIRONMENT=development

# --- Database -------------------------------------------------------------------
# SQLite needs no setup. For Postgres, run `docker compose up -d db` and use the second line.
DATABASE_URL=sqlite:///./itk-dev.db
# DATABASE_URL=postgresql://itk:itk@localhost:5432/itk
# Optional direct (non-pooled) connection for migrations, e.g. Neon's unpooled host.
# DATABASE_URL_UNPOOLED=

# --- URLs -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
PILOT_CITIES=austin,san antonio

# --- AI (OpenRouter) ------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.2
# OPENROUTER_SEARCH_MODEL=perplexity/sonar
# OPENROUTER_WRITING_MODEL=openai/gpt-5.2

# --- OAuth ----------------------------------------------------------------------
# Redirect URIs to register: {BACKEND_API_URL}/api/auth/google/callback and .../spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Browser key for address autocomplete in onboarding (restrict it to your domain).
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=ITK <onboarding@resend.dev>
RESEND_REPLY_TO_EMAIL=
# `whsec_...` signing secret from the Resend webhook, or any shared secret sent as X-Webhook-Secret.
RESEND_INBOUND_WEBHOOK_SECRET=
# EMAIL_OUTBOX_DIR=.outbox

# --- Secrets (required in production; generate with `openssl rand -base64 32`) --
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
API_CRON_SECRET=
